{
  "name": "AutsPanel — Free Open-Source Hosting Control Panel",
  "short_name": "AutsPanel",
  "description": "Free, open-source hosting control panel for Ubuntu & Debian VPS.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
